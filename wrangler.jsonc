{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rebrandyourbrand-proxy",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS_KV",
      "id": "14e2efbe226e41b1b6e2da931b5fa09e"
    }
  ],
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
